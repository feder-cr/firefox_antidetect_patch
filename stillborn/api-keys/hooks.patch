       : aMsg;
-    return AppConstants.MOZ_GOOGLE_SAFEBROWSING_API_KEY
-      ? aMsg.replace(
-          RegExp(AppConstants.MOZ_GOOGLE_SAFEBROWSING_API_KEY, "g"),
-          "[trimmed-google-api-key]"
-        )
+    return sb
+      ? aMsg.replace(RegExp(sb, "g"), "[trimmed-google-api-key]")
       : aMsg;
   },
 };
