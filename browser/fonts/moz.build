# Stealthfox: ship the Windows core font set so MOZ_BUNDLED_FONTS makes the
# whitelisted families render with genuine glyphs on every host (incl. Linux /
# macOS that lack them). The font-list ctor sets font.system.whitelist; without
# the bundled files a non-Windows host can't render the families. macOS also
# needs --enable-bundled-fonts in its mozconfig.
if CONFIG["MOZ_WIDGET_TOOLKIT"] in ("windows", "gtk", "cocoa"):
    DIST_SUBDIR = ""
