# STEALTH: the branding sets invisible_core can declare
# (zoom.stealth.branding.set), packaged outside anything a page can load.
DIRS += ["stealth"]

SPHINX_TREES["docs"] = "docs"

with Files("docs/**"):
    SCHEDULES.exclusive = ["docs"]
