# STEALTH: the branding sets invisible_core can declare
# (zoom.stealth.branding.set). The same 16 files chrome://branding/content/
# serves, one directory per brand, read from the brand directories already in
# the tree rather than copied. They land in chrome/browser/stealth-branding/,
# OUTSIDE browser/content/, because resource://usercontext-content/ exposes all
# of browser/content/ to pages, and a set sitting there would be a file a page
# can load. No manifest line registers them: no package or host name is added
# for a page to probe. netwerk/protocol/res/StealthBranding.h is the other half
# of the path.

browser.jar:
  stealth-branding/official/about.png                (../official/content/about.png)
  stealth-branding/official/about-logo.png           (../official/content/about-logo.png)
  stealth-branding/official/about-logo.svg           (../official/content/about-logo.svg)
  stealth-branding/official/about-logo@2x.png        (../official/content/about-logo@2x.png)
  stealth-branding/official/about-wordmark.svg       (../official/content/about-wordmark.svg)
  stealth-branding/official/about-logo-private.png   (../official/content/about-logo-private.png)
  stealth-branding/official/about-logo-private@2x.png (../official/content/about-logo-private@2x.png)
  stealth-branding/official/document.ico             (../official/document.ico)
  stealth-branding/official/document_pdf.svg         (../official/content/document_pdf.svg)
  stealth-branding/official/firefox-wordmark.svg     (../official/content/firefox-wordmark.svg)
  stealth-branding/official/icon16.png               (../official/default16.png)
  stealth-branding/official/icon32.png               (../official/default32.png)
  stealth-branding/official/icon48.png               (../official/default48.png)
  stealth-branding/official/icon64.png               (../official/default64.png)
  stealth-branding/official/icon128.png              (../official/default128.png)
  stealth-branding/official/aboutDialog.css          (../official/content/aboutDialog.css)
  stealth-branding/unofficial/about.png              (../unofficial/content/about.png)
  stealth-branding/unofficial/about-logo.png         (../unofficial/content/about-logo.png)
  stealth-branding/unofficial/about-logo.svg         (../unofficial/content/about-logo.svg)
  stealth-branding/unofficial/about-logo@2x.png      (../unofficial/content/about-logo@2x.png)
  stealth-branding/unofficial/about-wordmark.svg     (../unofficial/content/about-wordmark.svg)
  stealth-branding/unofficial/about-logo-private.png (../unofficial/content/about-logo-private.png)
  stealth-branding/unofficial/about-logo-private@2x.png (../unofficial/content/about-logo-private@2x.png)
  stealth-branding/unofficial/document.ico           (../unofficial/document.ico)
  stealth-branding/unofficial/document_pdf.svg       (../unofficial/content/document_pdf.svg)
  stealth-branding/unofficial/firefox-wordmark.svg   (../unofficial/content/firefox-wordmark.svg)
  stealth-branding/unofficial/icon16.png             (../unofficial/default16.png)
  stealth-branding/unofficial/icon32.png             (../unofficial/default32.png)
  stealth-branding/unofficial/icon48.png             (../unofficial/default48.png)
  stealth-branding/unofficial/icon64.png             (../unofficial/default64.png)
  stealth-branding/unofficial/icon128.png            (../unofficial/default128.png)
  stealth-branding/unofficial/aboutDialog.css        (../unofficial/content/aboutDialog.css)
