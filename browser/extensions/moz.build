# STEALTHFOX: the built-in newtab add-on is NOT built and NOT packaged. Measured
# 2026-08-14: it cost a whole extra content process and 75.4 MB of decoded
# images per session, of which 34.9 MB was one 3024x3024 sponsored tile fetched
# from ads-img.mozilla.org. about:home and about:newtab now resolve to the core
# blank tab page - see AboutNewTabRedirector.sys.mjs, which is where the URL is
# decided and therefore the only place that can make the page unreachable.
DIRS += [
    "data-leak-blocker",
    "formautofill",
    "ipp-activator",
    "webcompat",
    "pictureinpicture",
    "search-detection",
]

JAR_MANIFESTS += ["jar.mn"]
