+        // SPIR-V 1.4, so splat the condition.
+        let vec_condition_splat_id = self.id_gen.next();
+        block.body.push(Instruction::composite_construct(
+            self.get_vec2_bool_type_id(),
+            vec_condition_splat_id,
+            &[condition_id, condition_id],
+        ));
+
+        let result_id = self.id_gen.next();
+        block.body.push(Instruction::select(
+            vec2u_type_id,
+            result_id,
+            vec_condition_splat_id,
+            params_size_id,
+            plane_size_id,
+        ));
+
+        function.consume(block, Instruction::return_value(result_id));
+        function.to_words(&mut self.logical_layout.function_definitions);
