-               * to remember how many nr_local_addr we've converted for this
-               * ifaddrmsg, and set the label on all of them. */
-              rta = RTA_NEXT(rta, payload_len);
-            }
-
-            if (found) {
-              ++(*count);
-            }
-            break;
-          }
-        }
-      }
-      amount_read = recv(fd, &buf, kMaxReadSize, 0);
-    }
-  }
