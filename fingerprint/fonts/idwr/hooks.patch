diff --git a/gfx/skia/generate_mozbuild.py b/gfx/skia/generate_mozbuild.py
index 7cfdcfd923a712dbff8172cf41ef26b935d53fd5..c5597d16687afabe6a13fe78581931ca5070c167 100755
--- a/gfx/skia/generate_mozbuild.py
+++ b/gfx/skia/generate_mozbuild.py
@@ -31,12 +31,19 @@ if CONFIG['MOZ_OPTIMIZE']:
 
 """
 
+# STEALTH-HOOK(fingerprint/fonts/idwr): the SOURCES line after FINAL_LIBRARY below is ours (our
+# idwr port of Skia's DirectWrite text). moz.build is generated from this file, so the line is
+# part of the footer: regenerating Skia keeps it.
+# STEALTH-HOOK(fingerprint/canvas/skia-math): and so is the SOURCES line of StealthSkiaMath.cpp (the state and
+# the tables of the CPU-independent raster pipeline arithmetic, src/opts/StealthSkiaMath.h).
 footer = """
 
 # We allow warnings for third-party code that can be updated from upstream.
 AllowCompilerWarnings()
 
 FINAL_LIBRARY = 'xul'
+SOURCES += ['skia/src/ports/SkIdwrPathSink.cpp', 'skia/src/ports/SkScalerContext_idwr.cpp', 'skia/src/ports/SkTypeface_idwr.cpp']  # STEALTH-HOOK(fingerprint/fonts/idwr)
+SOURCES += ['skia/src/opts/StealthSkiaMath.cpp']  # STEALTH-HOOK(fingerprint/canvas/skia-math)
 LOCAL_INCLUDES += [
     'skia',
 ]
