# idwr: DirectWrite 10.0.26100.9711's text rasterizer in portable C, the one text
# engine of every OS once phase 4 lands (invisible_DWriteCore, notes/phase4-plan.md).
# src/ is that repository at the commit in moz.yaml and nothing else: fix idwr
# upstream and vendor again (scripts/vendor_to_engine.py there), never here.

if CONFIG["TARGET_CPU"] in ("x86_64", "aarch64"):
    EXPORTS.idwr += [
        "src/idwr/idwr.h",
        "src/idwr/idwr_fallback.h",
        "src/idwr/idwr_math.h",
    ]

    include("sources.mozbuild")
    SOURCES += ["IdwrHost.cpp"]

    # libxul's own sin, cos, tan, sinf, cosf, tanf, powf, hypot, pow, expf, logf, asinf, acosf, atanf,
    # atan2f (and sincos, sincosf), hidden, with idwr_math's bodies: every reference inside libxul binds to ucrtbase's results, never
    # to the host libm. Not on Windows, where ucrtbase is the reference. A native object
    # (-fno-lto) so LTO cannot drop a definition that code generation still calls, and
    # -fno-builtin so the compiler does not treat these definitions as library calls.
    if CONFIG["OS_ARCH"] != "WINNT":
        SOURCES += ["libm_ucrt.c"]
        SOURCES["libm_ucrt.c"].flags += ["-fno-lto", "-fno-builtin"]

    DEFINES["IDWR_STANDALONE"] = True
    DEFINES["IDWR_CFF"] = True
    DEFINES["IDWR_STATIC"] = True

    LOCAL_INCLUDES += ["src/cff", "src/idwr", "src/truetype"]

    # As verified upstream: -O2, and no PGO until the in-libxul golden test runs on a
    # PGO+LTO build. mozbuild already gives every C file -ffp-contract=off and
    # -fno-strict-aliasing, which the code needs.
    CFLAGS += ["-O2"]
    NO_PGO = True

    if CONFIG["CC_TYPE"] in ("clang", "clang-cl"):
        CFLAGS += ["-Wno-unused-parameter"]

    FINAL_LIBRARY = "xul"

    TEST_DIRS += ["tests/gtest"]
