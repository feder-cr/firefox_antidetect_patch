# Read by gfx/thebes/moz.build (one include line).

# dom/canvas reads the coverage ladder through the exported header.
EXPORTS += [
    "StealthBundleFontList.h",
]

# Non-unified: file-static helpers with short names.
SOURCES += [
    "StealthBundleFontList.cpp",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
    SOURCES += [
        "StealthDWriteFontList.cpp",
    ]
