# Read by gfx/thebes/moz.build (one include line).

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    # Exported: widget/gtk/nsLookAndFeel.cpp calls it before FcInit().
    EXPORTS += [
        "StealthFcEmptyConfig.h",
    ]
    # Non-unified: it declares the system cairo's functions after undefining
    # the tree cairo's macros, as gfxFcPlatformFontList.cpp does.
    SOURCES += [
        "StealthFcEmptyConfig.cpp",
    ]
