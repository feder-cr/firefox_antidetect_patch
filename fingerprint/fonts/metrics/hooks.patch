+            : aMetrics->emHeight;
+    aMetrics->emDescent = aMetrics->emHeight - aMetrics->emAscent;
+    aMetrics->internalLeading =
+        std::max(aMetrics->maxHeight - aMetrics->emHeight, 0.0);
+    aMetrics->externalLeading = std::ceil(vm.mLineGap * conv);
