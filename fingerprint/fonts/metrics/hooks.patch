+    aMetrics->maxAscent = NS_round(vm.mAscent * conv);
+    aMetrics->maxDescent = NS_round(vm.mDescent * conv);
+    aMetrics->maxHeight = aMetrics->maxAscent + aMetrics->maxDescent;
+    aMetrics->emHeight = size;
