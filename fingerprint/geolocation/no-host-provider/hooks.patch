-    mWatching = false;
-  }
-
-  return NS_OK;
-}
-
-NS_IMETHODIMP
-WindowsLocationProvider::SetHighAccuracy(bool enable) {
-  LOG("WindowsLocationProvider::SetHighAccuracy(%p, %p, %p, %s)", this,
