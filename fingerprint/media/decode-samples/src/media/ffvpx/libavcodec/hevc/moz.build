# The HEVC decoder: a directory of its own because its file names
# (cabac.c, parser.c) are also libavcodec's.

SOURCES += [
    'cabac.c',
    'data.c',
    'dsp.c',
    'filter.c',
    'hevcdec.c',
    'mvs.c',
    'parse.c',
    'parser.c',
    'pred.c',
    'ps.c',
    'refs.c',
    'sei.c',
]

LOCAL_INCLUDES += ['/modules/fdlibm/inexact-math-override']

FINAL_LIBRARY = 'mozavcodec'

include('/media/ffvpx/ffvpxcommon.mozbuild')
