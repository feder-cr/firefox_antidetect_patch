+
+  // ff_h264_decoder (h264dec.c) does not set FF_CODEC_CAP_SETS_FRAME_PROPS.
+  // For such decoders the generic ffmpeg layer (media/ffvpx/libavcodec/
+  // decode.c) stamps every frame coming out of avcodec_receive_frame()
+  // with the pts/pkt_dts/opaque of the MOST RECENTLY SENT packet
+  // (avci->last_pkt_props), not the packet that actually produced that
+  // image; frame->best_effort_timestamp (guess_correct_pts()) is derived
+  // from that same wrong pts/pkt_dts, so it inherits the same mislabeling
+  // (confirmed with a real build: MOZ_LOG="FFmpegVideo:5" on a 1080p
+  // B-frame clip, has_b_frames=2; also confirmed identical on Firefox
+  // 159.0 retail Linux using the distro's own libavcodec.so.59, so this
+  // is a Mozilla-wrapper-level gap, not specific to our ffvpx). With
+  // B-frames the image can come out several packets after it was sent,
+  // so none of those labels can be trusted here, while the IMAGE order
+  // itself is already correct. We track the real (time, duration) of
+  // every sample we send ourselves: one entry is pushed before each
+  // avcodec_send_packet(), and the entry with the smallest pending time
+  // is popped for every frame avcodec_receive_frame() actually returns
+  // (not the oldest sent one: with real B-frames, pts is not monotonic
+  // in send order).
+  struct PendingFrameTime {
+    int64_t mTime;
+    int64_t mDuration;
+  };
+  nsTArray<PendingFrameTime> mPendingFrameTimes;
 #endif
 
