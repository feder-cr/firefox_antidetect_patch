+    # built here from gfx/idwr's own source (invisible_DWriteCore), the same bits as Media
+    # Foundation's CRT call. Not USE_LIBS: idwr there is FINAL_LIBRARY='xul', private to libxul,
+    # so mozavcodec (a separate shared library) compiles its own copy of this one small file.
+    LOCAL_INCLUDES += ['/gfx/idwr/src/idwr']
+    DEFINES['IDWR_STATIC'] = True
+    SOURCES += ['/gfx/idwr/src/idwr/idwr_math.c']
+    SOURCES['/gfx/idwr/src/idwr/idwr_math.c'].flags += ['-fvisibility=hidden']
+
+    # H.264 and HEVC, wired with their x86 DSP (config_override.h).
+    if CONFIG['TARGET_CPU'] in ('x86', 'x86_64'):
+        SOURCES += [
+            'bswapdsp.c',
+            'cabac.c',
