index e067c996f20fee4cf510a4924f37130503335d73..934395a019d171b1db3334a91a1c969818b93c10 100644
--- a/media/ffvpx/libavcodec/moz.build
+++ b/media/ffvpx/libavcodec/moz.build
@@ -128,6 +128,86 @@ if not CONFIG['MOZ_FFVPX_AUDIOONLY']:
         'vpx_rac.c',
     ]
 
+    # AAC, plain C only (MOZ_FFVPX_AAC_C_ONLY in config_override.h).
+    SOURCES += [
+        'aac/aacdec.c',
+        'aac/aacdec_ac.c',
+        'aac/aacdec_float.c',
+        'aac/aacdec_lpd.c',
+        'aac/aacdec_tab.c',
+        'aac/aacdec_usac.c',
+        'aac/aacdec_usac_mps212.c',
+        'aac/mf_dct.c',
+        'aac/mf_imlt.c',
+        'aac/mf_tables.c',
+        'aac_ac3_parser.c',
+        'aac_parser.c',
+        'aacps_common.c',
+        'aacps_float.c',
+        'aacpsdsp_float.c',
+        'aacsbr.c',
+        'aactab.c',
+        'cbrt_data.c',
+        'cbrt_tablegen_common.c',
+        'kbdwin.c',
+        'sbrdsp.c',
+        'sinewin.c',
+    ]
+
+    # The AAC float code equals Media Foundation to the bit: no fused multiply-add where the
+    # source has a multiply and an add (aacdec_mf.h).
+    if CONFIG['CC_TYPE'] in ('clang', 'gcc'):
+        for f in (
+            'aac/aacdec_float.c',
+            'aac/mf_dct.c',
+            'aac/mf_imlt.c',
+        ):
+            SOURCES[f].flags += ['-ffp-contract=off']
+
+    # aacdec_mf.h (scalefactor gain, x^(4/3) for |q| >= 1024) and aacdec_proc_template.c's
+    # pulses need pow/powf bit-exact to ucrtbase.dll, never the host's libm: idwr_pow/idwr_powf,
+    # built here from gfx/idwr's own source (invisible_DWriteCore), the same bits as Media
+    # Foundation's CRT call. Not USE_LIBS: idwr there is FINAL_LIBRARY='xul', private to libxul,
+    # so mozavcodec (a separate shared library) compiles its own copy of this one small file.
+    LOCAL_INCLUDES += ['/gfx/idwr/src/idwr']
+    DEFINES['IDWR_STATIC'] = True
+    SOURCES += ['/gfx/idwr/src/idwr/idwr_math.c']
+    SOURCES['/gfx/idwr/src/idwr/idwr_math.c'].flags += ['-fvisibility=hidden']
+
+    # H.264 and HEVC, wired with their x86 DSP (config_override.h).
+    if CONFIG['TARGET_CPU'] in ('x86', 'x86_64'):
+        SOURCES += [
+            'bswapdsp.c',
+            'cabac.c',
+            'error_resilience.c',
+            'h2645_parse.c',
+            'h2645_sei.c',
+            'h2645_vui.c',
+            'h2645data.c',
+            'h264_cabac.c',
+            'h264_cavlc.c',
+            'h264_direct.c',
+            'h264_loopfilter.c',
+            'h264_mb.c',
+            'h264_parse.c',
+            'h264_parser.c',
+            'h264_picture.c',
+            'h264_ps.c',
+            'h264_refs.c',
+            'h264_sei.c',
+            'h264_slice.c',
+            'h264chroma.c',
+            'h264data.c',
+            'h264dec.c',
+            'h264dsp.c',
+            'h264idct.c',
+            'h264qpel.c',
+            'h274.c',
+            'me_cmp.c',
+            'startcode.c',
+        ]
+        DIRS += ['hevc']
+
     if CONFIG["MOZ_SYSTEM_AV1"]:
         CFLAGS += CONFIG['MOZ_SYSTEM_LIBDAV1D_CFLAGS']
         CFLAGS += CONFIG['MOZ_SYSTEM_LIBAOM_CFLAGS']
