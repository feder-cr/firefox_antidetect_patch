diff --git a/media/ffvpx/config_override.h b/media/ffvpx/config_override.h
index 5bf8d741c96fbfa2d69d1b571fb9730d0e2a1b9d..61c442655d2d6d39673d333a87baf0533e85d165 100644
--- a/media/ffvpx/config_override.h
+++ b/media/ffvpx/config_override.h
@@ -1,5 +1,77 @@
 // This file contains overrides for config.h, that can be platform-specific.
 
+// modules/fdlibm/inexact-math-override/math.h maps log2f to fdlibm_log2f, which
+// fdlibm does not have. libavutil/libm.h then uses (float)log2(x).
+#undef HAVE_LOG2F
+#define HAVE_LOG2F 0
+
+#define MOZ_FFVPX_AAC_C_ONLY 1
+
+// The H.264, HEVC and AAC decoders, and what FFmpeg 9.0.1's configure
+// selects for them (`--enable-decoder=h264,hevc,aac
+// --enable-parser=h264,hevc,aac` on top of FFMPEG_CONFIGURATION).
+// H.264 and HEVC are wired with their x86 DSP only, so on other CPUs they
+// stay off. AAC runs plain C on every CPU (MOZ_FFVPX_AAC_C_ONLY), so its
+// output does not depend on the CPU.
+#if !defined(MOZ_FFVPX_AUDIOONLY)
+#  if defined(__x86_64__) || defined(__i386__) || defined(_M_X64) || defined(_M_IX86)
+#    define MOZ_FFVPX_H26X 1
+#  else
+#    define MOZ_FFVPX_H26X 0
+#  endif
+#  undef CONFIG_H264_DECODER
+#  define CONFIG_H264_DECODER MOZ_FFVPX_H26X
+#  undef CONFIG_HEVC_DECODER
+#  define CONFIG_HEVC_DECODER MOZ_FFVPX_H26X
+#  undef CONFIG_H264_PARSER
+#  define CONFIG_H264_PARSER MOZ_FFVPX_H26X
+#  undef CONFIG_HEVC_PARSER
+#  define CONFIG_HEVC_PARSER MOZ_FFVPX_H26X
+#  undef CONFIG_ERROR_RESILIENCE
+#  define CONFIG_ERROR_RESILIENCE MOZ_FFVPX_H26X
+#  undef CONFIG_BSWAPDSP
+#  define CONFIG_BSWAPDSP MOZ_FFVPX_H26X
+#  undef CONFIG_CABAC
+#  define CONFIG_CABAC MOZ_FFVPX_H26X
+#  undef CONFIG_H264CHROMA
+#  define CONFIG_H264CHROMA MOZ_FFVPX_H26X
+#  undef CONFIG_H264DSP
+#  define CONFIG_H264DSP MOZ_FFVPX_H26X
+#  undef CONFIG_H264PARSE
+#  define CONFIG_H264PARSE MOZ_FFVPX_H26X
+#  undef CONFIG_H264QPEL
+#  define CONFIG_H264QPEL MOZ_FFVPX_H26X
+#  undef CONFIG_H264_SEI
+#  define CONFIG_H264_SEI MOZ_FFVPX_H26X
+#  undef CONFIG_HEVCPARSE
+#  define CONFIG_HEVCPARSE MOZ_FFVPX_H26X
+#  undef CONFIG_HEVC_SEI
+#  define CONFIG_HEVC_SEI MOZ_FFVPX_H26X
+#  undef CONFIG_ME_CMP
+#  define CONFIG_ME_CMP MOZ_FFVPX_H26X
+#  undef CONFIG_STARTCODE
+#  define CONFIG_STARTCODE MOZ_FFVPX_H26X
+#  define CONFIG_H264_D3D12VA_HWACCEL 0
+#  define CONFIG_HEVC_D3D12VA_HWACCEL 0
+#  define CONFIG_VVC_SEI 0
+// libmozavcodec is position independent: the CABAC inline asm must not take
+// the address of ff_h264_cabac_tables as an absolute 32-bit relocation.
+#  ifndef BROKEN_RELOCATIONS
+#    define BROKEN_RELOCATIONS 1
+#  endif
+// libavutil/x86/asm.h reads PIC to address symbols from inline asm
+// rip-relative.
+#  if defined(__x86_64__) && defined(__PIC__) && !defined(PIC)
+#    define PIC 1
+#  endif
+#  undef CONFIG_ADTS_HEADER
+#  define CONFIG_ADTS_HEADER 1
+#  undef CONFIG_MPEG4AUDIO
+#  define CONFIG_MPEG4AUDIO 1
+#  undef CONFIG_SINEWIN
+#  define CONFIG_SINEWIN 1
+#endif
+
 // CBS is required for VP9 and AV1 decoding.
 #if !defined(MOZ_FFVPX_AUDIOONLY)
 #undef CONFIG_CBS
