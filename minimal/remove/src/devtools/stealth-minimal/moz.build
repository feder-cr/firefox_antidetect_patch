# Built only with --enable-stealth-minimal (mozbuild/frontend/stealth_minimal.py adds it).
# GENERATED jar.mn (toolkit/stealth-minimal/keep_jar.py): the chrome files of the directories
# the minimal engine leaves out of the build, the same bytes as retail.
JAR_MANIFESTS += ["jar.mn"]
