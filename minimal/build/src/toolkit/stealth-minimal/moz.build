# Built only with --enable-stealth-minimal (toolkit/moz.build).
# jar.mn: what the build options leave out but a page can read.
# StealthMinimal.sys.mjs + components.conf: the actors the minimal engine unregisters.
JAR_MANIFESTS += ["jar.mn"]
EXTRA_JS_MODULES += ["StealthMinimal.sys.mjs"]
XPCOM_MANIFESTS += ["components.conf"]
