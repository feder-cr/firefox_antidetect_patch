ac_add_options --enable-application=browser

# ============================================================================
# PARITA' COL RETAIL - firefox-21, decisione del proprietario 2026-08-19:
# "dobbiamo essere il piu' simili possibile a retail, quindi usa tutte le cose
# del retail".
#
# ⛔ QUESTO FILE NON E' STATO SCRITTO A INTUITO. E' allineato al mozconfig con
# cui Mozilla costruisce la release win64, che sta nell'albero e si legge:
#     browser/config/mozconfigs/win64/release
#       -> build/mozconfig.win-common          (vuoto)
#       -> browser/config/mozconfigs/win64/common-win64   (target + clang-cl)
#       -> browser/config/mozconfigs/win64/common-opt
#            --enable-update-channel=${MOZ_UPDATE_CHANNEL}
#            --with-google-location-service-api-keyfile=...
#            --with-google-safebrowsing-api-keyfile=...
#            --with-mozilla-api-keyfile=...
#            export MOZILLA_OFFICIAL=1
#            export MOZ_PACKAGE_JSSHELL=1
#       -> --enable-official-branding
#       -> build/mozconfig.common   (AUTOCLOBBER=1, --enable-js-shell)
#
# Il fatto che conta: in quella catena NON C'E' NEMMENO UN `--disable-*`.
# Crashreporter, background task, test e i tre agenti Windows sono tutti ACCESI
# in una release. Ogni `--disable-` che avevamo era una divergenza dal retail.
# ============================================================================

ac_add_options --disable-debug
ac_add_options --enable-release

# ⛔ MOZILLA_OFFICIAL non e' un dettaglio di targa: e' il fatto da cui dipendono
# sei prefs piu' due cancelli di build, e DUE di quelle prefs viaggiano DENTRO
# la richiesta a Google Safe Browsing:
#
#   browser.safebrowsing.id      navclient-auto-ffox  <- ufficiale
#                                Firefox              <- noi, prima di qui
#   urlclassifier.phishTable     goog-phish-proto     <- ufficiale
#                                googpub-phish-proto  <- noi, prima di qui
#
# Il commento upstream accanto e' esplicito: "These names are approved by the
# Google Safe Browsing team". Accendere Safe Browsing SENZA questo flag avrebbe
# mandato a Google due valori che ci dichiarano build non ufficiale: non
# un'assenza, un tell positivo. Per questo il flag viene PRIMA della chiave.
#
# Le altre quattro: browser.dom.window.dump.enabled, devtools.chrome.enabled,
# devtools.debugger.remote-enabled, termsofuse.bypassNotification.
# I due cancelli di build: GetIsOfficialTelemetry (Telemetry.cpp:746-754) e
# MOZ_TELEMETRY_REPORTING, che ha `default=mozilla_official`.
export MOZILLA_OFFICIAL=1

# Il canale compare nella URL di aggiornamento e determina MOZ_APP_REMOTINGNAME
# (toolkit/moz.configure:3336-3350): con "release" vale `firefox`, altrimenti
# `firefox-<canale>`, e il nostro era `firefox-default`.
ac_add_options --enable-update-channel=release

# ⛔ IL MARCHIO UFFICIALE E' SPENTO, ED E' UNA DECISIONE DEL PROPRIETARIO
# (2026-08-20): "se gli antibot non possono detectare questo puoi levarlo".
# Qui stava `ac_add_options --enable-official-branding`, e NON va rimessa
# senza rifare la misura qui sotto.
#
# LA CONDIZIONE E' STATA VERIFICATA. Il flag muove DIECI cose: una variabile
# (`MOZ_APP_DISPLAYNAME`, Firefox -> Nightly, in browser/branding/*/configure.sh)
# e nove prefs in `browser/branding/<marchio>/pref/firefox-branding.js`:
#   startup.homepage_welcome_url      about:welcome -> vuoto
#   app.update.interval               6h -> 24h
#   app.update.checkInstallTime.days  63 -> 2
#   app.update.promptWaitTime / badgeWaitTime   lunghi -> corti
#   app.update.url.manual / .details  mozilla.org -> nightly.mozilla.org
#   app.releaseNotesURL x3            presenti -> assenti
#   devtools.selfxss.count            0 -> 5
# NESSUNA e' leggibile da una pagina: le prefs non sono esposte al contenuto, e
# le due a secondo effetto (welcome, aggiornamenti) agiscono sulla RETE
# D'AVVIO, dove dei venti host in gioco ZERO sono visibili al sito visitato
# (27-retail-network-parity.md sezione 12).
#
# ⛔ E LA UA E' SALVA, che era il rischio vero e non ovvio. `MOZ_APP_UA_NAME` e'
# vuoto per default (toolkit/moz.configure), quindi nsHttpHandler cade su
# `application.ini` Name; se li' uscisse "Nightly", `isFirefox` sarebbe falso
# (nsHttpHandler.cpp:1064) e la UA guadagnerebbe " Nightly/151.0" in coda.
# MISURATO su due artefatti veri: firefox-20 (senza marchio) e firefox-21 (con
# marchio) dichiarano ENTRAMBI Name=Firefox e Vendor=Mozilla. Il campo Name non
# viene da MOZ_APP_DISPLAYNAME - se venisse, firefox-20 direbbe Nightly.
# La prova piu' forte: il prodotto spedito oggi, firefox-20, e' gia' costruito
# senza marchio ufficiale e passa tutti i gate dei rilevatori.
# `RemotingName` lo decide il CANALE, non il marchio: con
# --enable-update-channel=release resta `firefox`, come nel retail.
#
# COSA SI GUADAGNA: la politica sui marchi di Mozilla non consente di
# distribuire un Firefox MODIFICATO col marchio ufficiale, e questo account e'
# gia' stato sospeso una volta. `scripts/check_branding.py` rifiutava il binario
# finche' la riga era qui.
#
# ⛔ MA TOGLIERE LA RIGA NON BASTA, E LA PRIMA VERSIONE DI QUESTO COMMENTO
# DICEVA CHE BASTAVA. Misurato il 2026-08-20: dopo la ricompilazione
# `config.status` portava gia' MOZ_APP_DISPLAYNAME='Nightly' e
# MOZ_BRANDING_DIRECTORY='browser/branding/unofficial', e l'eseguibile
# dichiarava ANCORA ProductName=Firefox. La catena e'
#     module.ver -> firefox.exe.rc -> firefox.exe.res -> firefox.exe
# e NESSUNO dei due passi generati dipende da config.status nel grafo delle
# dipendenze: 64 file .rc e 78 .res erano fermi al giorno prima. Vanno
# cancellati a mano e la build li rifa'.
#
# ⛔ E CANCELLARE SOLO I .res NON BASTA: al primo tentativo ho tolto quelli e la
# build ha rigenerato le risorse DAL .rc vecchio, quindi ProductName e' rimasto
# Firefox e sembrava che la diagnosi fosse sbagliata. Si cancellano ENTRAMBI:
#     find <objdir> -name '*.rc' -not -newermt '<data della riconfigurazione>' -delete
#     find <objdir> -name '*.res' -delete
# Verifica: ProductName deve dire Nightly, e `python scripts/check_branding.py
# <exe>` deve dire PUBBLICABILE. Non fidarsi del fatto che la build sia verde:
# qui e' stata verde tre volte con il marchio sbagliato dentro.

# ⛔ LE TRE CHIAVI API NON SI COMPILANO PIU' DENTRO IL BINARIO.
# Decisione del proprietario, 2026-08-20: "voglio portare questi valori su
# invisible_core, trova il modo che ogni volta che firefox si avvia li legga e
# li setti prendendoli da invisible_core, come stiamo fondamentalmente facendo
# per tutte le altre cose che invisible_core genera".
#
# Qui stavano, e NON vanno rimesse:
#   APIKEYDIR="${APIKEYDIR:-C:/builds}"   (e /builds su Linux)
#   ac_add_options --with-google-location-service-api-keyfile=${APIKEYDIR}/gls-gapi.data
#   ac_add_options --with-google-safebrowsing-api-keyfile=${APIKEYDIR}/sb-gapi.data
#   ac_add_options --with-mozilla-api-keyfile=${APIKEYDIR}/mozilla-desktop-geoloc-api.key
#
# COSA E' STATO TOLTO INSIEME, perche' un pezzo solo non sarebbe servito:
#   toolkit/modules/AppConstants.sys.mjs  le tre voci @MOZ_..._API_KEY@
#   toolkit/modules/moz.build             i tre DEFINES che le alimentavano
# e il solo lettore, URLFormatter.sys.mjs, adesso legge le pref
# `zoom.stealth.apikey.*` invece delle costanti (stealthDeclaredApiKey).
#
# PERCHE' e' la regola 1 del motore e non un capriccio: "il core dichiara, il
# motore obbedisce... anche a costo di aggiungere pref nel browser e
# ricompilarlo". Il dominio e' finito e noto - tre chiavi - quindi la regola 2
# e' soddisfatta. Una costante compilata accanto a una dichiarazione del core
# sarebbero due fonti per lo stesso valore, che la regola 7 vieta.
#
# ⛔ E LA MODALITA' DI FALLIMENTO CHE QUESTO TOGLIE DI MEZZO era asimmetrica,
# che e' cio' che la rendeva pericolosa: con i keyfile illeggibili le due
# chiavi GOOGLE ricadevano in SILENZIO sulla sentinella e solo quella Mozilla
# era fatale. Misurato il 2026-08-20: con i percorsi sbagliati configure ha
# protestato SOLO per la terza, quindi la build sarebbe passata verde senza
# chiavi e senza dirlo. Adesso l'assenza e' un errore in console a ogni uso.

# ⛔ QUI SOTTO C'ERANO SEI `--disable-`, E OGNUNO ERA UNA DIVERGENZA.
# Tolti tutti, perche' la release di Mozilla non ne ha nessuno:
#
#   --disable-crashreporter        il retail ce l'ha (default=crashreporter_default)
#   --disable-backgroundtasks      il retail ce l'ha
#   --disable-tests                il retail li compila (moz.configure:91, default on)
#   --disable-default-browser-agent \
#   --disable-maintenance-service   > tutti e tre accesi in una release win64
#   --disable-update-agent         /
#
# Gli agenti Windows non modificano la macchina per il solo fatto di essere
# compilati: e' l'INSTALLER a registrare servizi e attivita' pianificate, e noi
# spediamo un archivio. Compilarli allinea l'elenco dei file del pacchetto al
# retail senza installare niente.
#
# `MOZ_REQUIRE_SIGNING` era esportata VUOTA, cioe' spenta. Il default e'
# `require_signing` e sul canale release e' ACCESO (toolkit/moz.configure:2034).
# ⛔ Conseguenza da conoscere: con la firma richiesta, un'estensione non firmata
# non si carica. Juggler e' compilato dentro e non e' un'estensione, quindi il
# percorso del prodotto non cambia; cambia per chi carica estensioni proprie.

# L'updater: il retail lo ha compilato e CONTROLLA all'avvio. Noi controlliamo
# come lui, ma `app.update.auto=false` in invisible_core impedisce download e
# installazione - installare distruggerebbe il binario pinnato dal sigillo.
# (`app.update.enabled` non esiste piu' in 151: era una pref morta.)

ac_add_options --enable-bootstrap

# Bundle the Windows core font set on EVERY desktop OS. bundled_fonts_default in
# toolkit/moz.configure enables MOZ_BUNDLED_FONTS only for Windows + Linux, so
# macOS defaulted OFF: the bundle never loaded and our bundle-only block-at-birth
# hooks (behind #ifdef MOZ_BUNDLED_FONTS) were compiled out, leaking host fonts.
# Enabling it explicitly is a no-op on Win/Linux (already on) and turns the
# self-contained font persona on for macOS. The font files are packaged on cocoa
# already (browser/fonts/moz.build).
#
# ⛔ E' l'UNICA divergenza deliberata rimasta dal mozconfig di release, ed e'
# una funzione di stealth, non una soppressione: aggiunge font, non ne toglie.
ac_add_options --enable-bundled-fonts

# L'installer NSIS resta fuori: e' un ARTEFATTO separato, non una proprieta' del
# browser che gira. Il retail lo spedisce, noi spediamo un archivio, e nessuna
# pagina ne' la rete possono distinguere le due cose. Il js shell (che Mozilla
# impacchetta con MOZ_PACKAGE_JSSHELL) resta fuori per la stessa ragione.
mk_add_options MOZ_INSTALLER=0
mk_add_options MOZ_AUTOMATION_INSTALLER=0

# HTTP/3 verso Google: il proxy non implementa UDP ASSOCIATE, quindi QUIC non
# passa e non passera' finche' si esce da questi proxy.
#
# ⛔ MA NON E' UN DIVARIO NOSTRO, e la riga che stava qui diceva il contrario.
# Era stata scritta confrontando il NOSTRO percorso proxato con un retail
# DIRETTO, che mescola "siamo diversi" con "il proxy e' diverso". Misurato il
# 2026-08-19 con tre bracci sulla stessa uscita pinnata e lo stesso strumento:
# il retail DIRETTO usa h3, il retail DAL PROXY no, noi dal proxy no, e tutti e
# tre ricevono `alt-svc: h3=":443"` da Google. Quindi non ci separa da un retail
# che esce dallo stesso posto, e non c'e' niente da recuperare.
# Il conto per esteso: docs/firefox-stealth-architecture/27-retail-network-parity.md
# sezione 9.

# ============================================================================
# UNA SOLA CONFIGURAZIONE PER LE DUE MACCHINE (2026-08-22)
# ============================================================================
#
# Fino a oggi il lato Linux aveva un mozconfig suo, e non era un sottoinsieme:
# portava DIECI righe in piu', tutte disattivazioni, e ognuna era un passo via
# dal retail. Sono state tolte tutte, su richiesta del proprietario: "attiva la
# telemetria su tutti, deve sembrare il piu' possibile un Windows Firefox".
# La direzione e' quella della regola 4 - si sposta Linux su Windows, mai il
# contrario.
#
#   RIGA TOLTA DAL LATO LINUX          COSA FACEVA            IL RETAIL
#   --disable-crashreporter            via il crash reporter  ce l'ha
#   mk MOZ_CRASHREPORTER=0             idem                   ce l'ha
#   --disable-updater                  via l'updater          ce l'ha
#   --disable-backgroundtasks          via i task di sfondo   ce l'ha
#   mk MOZ_TELEMETRY_REPORTING=0       telemetria spenta      accesa
#   mk MOZ_DATA_REPORTING=0            idem                   accesa
#   mk MOZ_SERVICES_HEALTHREPORT=0     idem                   accesa
#   export MOZ_REQUIRE_SIGNING=        estensioni non firmate le pretende
#   --disable-tests                    build piu' piccola     non osservabile
#   case uname -s -> 3 agenti Windows  gia' fatto dalla CI    -
#
# Nessuna era una necessita' di piattaforma: Windows compila senza tutte e
# dieci, e lo fa da sempre.
#
# ⛔ PERCHE' UN FILE SOLO E NON DUE PER-OS. Per qualche ora, oggi, questo file
# e' stato un dispatcher che sceglieva `.mozconfig-win` o `.mozconfig-linux`
# guardando `uname`. Con le due configurazioni diventate IDENTICHE quei due
# file sarebbero copie uguali, cioe' esattamente il posto dove qualcuno
# aggiunge un'opzione da una parte sola e la divergenza ricomincia. Il
# dispatcher risolveva il problema sbagliato: il difetto non era "un file
# unico", era "un file unico che conteneva la configurazione di UNA delle due
# macchine".
#
# ⛔ E QUESTO FILE DECIDE ANCHE COSA COSTRUISCE LA CI. `release.yml` non ha un
# mozconfig suo: fa `test -f .mozconfig` e ci APPENDE le opzioni per target
# (`--target=`, l'SDK di macOS, i tre agenti su Windows, MOZ_OBJDIR). Quindi
# una riga scritta qui vale per tutte e cinque le gambe. Prima di oggi su
# `origin` c'era la versione LINUX, quindi tutte e cinque costruivano
# NON ufficiale; da qui in avanti costruiscono tutte ufficiale.
#
# ⛔ CAMBIARE QUESTO FILE FORZA UN RECONFIGURE, cioe' una ricompilazione
# completa su ENTRAMBE le macchine (3-4 ore, non i 15-60 minuti
# dell'incrementale). Non e' una modifica da fare il giorno di un rilascio.
#
# ⛔ E LA PRIMA BUILD LINUX CON `MOZILLA_OFFICIAL` E' UNA MISURA, NON UNA
# FORMALITA': quel flag spegne `browser.dom.window.dump.enabled`, e da li'
# passa la riga `Juggler listening to the pipe`. Senza il rimedio in
# `juggler/components/Juggler.js` ogni `launch` scade col pipe perfettamente
# funzionante e nessun errore da nessuna parte. Il rimedio in questo albero
# c'e', ed e' verificato presente su entrambi i checkout - ma e' stato MISURATO
# solo su Windows. La prima cosa da provare dopo la build Linux e' un `launch`.

# ============================================================================
# VELOCITA' DI BUILD (2026-08-22)
# ============================================================================
#
# Fino a oggi non c'era NESSUNA cache di compilazione: ne' ccache ne' sccache,
# e nessun parallelismo dichiarato. Era la leva piu' grossa disponibile e non
# era mai stata toccata.
#
# sccache invece di ccache perche' cachea anche gli artefatti Rust, che in
# Firefox sono una fetta grande. La documentazione Mozilla: dalla 0.7.4 la
# modalita' preprocessor-cache e' il default e "decreases the build time by a
# factor of 2 to 3" a cache calda. ⛔ La PRIMA build sara' piu' LENTA, per il
# lavoro di popolamento: il guadagno arriva dalla seconda in poi, quindi non
# si giudica questa scelta sul primo giro.
#
# Il nome e basta, senza percorso: `sccache` sta nel PATH di entrambe le
# macchine (Windows ~/.cargo/bin, Linux ~/.local/bin) e il percorso e' una
# proprieta' della macchina, non del sorgente - scriverlo qui rimetterebbe in
# questo file una differenza per-OS, che e' esattamente cio' che il 2026-08-22
# e' stato tolto.
ac_add_options --with-ccache=sccache

# --with-ccache copre C/C++ ma NON Rust: quello passa da RUSTC_WRAPPER, che
# build/moz.configure/toolchain.configure tratta come opzione separata.
mk_add_options 'export RUSTC_WRAPPER=sccache'

# Il default di sccache e' 10 GB, che per un albero Firefox si riempie e
# sfratta le voci che servono, cioe' vanifica la cache. Qui c'e' spazio.
mk_add_options 'export SCCACHE_CACHE_SIZE=50G'

# 16 core su questa macchina. La documentazione Mozilla dice che i ritorni
# (calanti) arrivano fino a 1,5-2,0 volte il numero di core, quindi 24 e' il
# basso di quella forbice. Non 32: questo file vale per ENTRAMBE le macchine e
# WSL vede 31 GB di RAM contro i 63 dell'host, quindi il numero lo detta la
# macchina piu' stretta. Se un giorno le due divergono, il posto giusto NON e'
# un ramo per-OS qui dentro: e' MOZ_PARALLEL_BUILD nell'ambiente della singola
# macchina, che vince su questa riga.
mk_add_options MOZ_PARALLEL_BUILD=32

# ⛔ I SIMBOLI DI DEBUG SONO PRODOTTI DI DEFAULT ANCHE NELLE BUILD OPT, e sono
# il costo piu' grosso di una build fredda: piu' lavoro al compilatore e un
# link di libxul molto piu' pesante.
#
# Toglierli non ci allontana da cio' che spediamo - ci AVVICINA. `release.yml`
# appende gia' `--disable-debug-symbols` a tutte e cinque le gambe, quindi gli
# asset pubblicati non li hanno mai avuti: erano le build LOCALI a essere
# diverse, oltre che piu' lente.
#
# Il prezzo, ed e' reale: un crash locale non avra' uno stack simbolizzato. Per
# una diagnosi che li richiede si rimette la riga a mano per quella build.
ac_add_options --disable-debug-symbols
