ac_add_options --enable-application=browser

ac_add_options --disable-crashreporter
ac_add_options --disable-backgroundtasks
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-updater
ac_add_options --enable-release

# Win-only flags: maintenance-service, update-agent, default-browser-agent are
# all Windows-specific build-system options. Skip them on Linux/macOS, where
# configure rejects them as "not available in this configuration".
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
        ac_add_options --disable-default-browser-agent
        ac_add_options --disable-maintenance-service
        ac_add_options --disable-update-agent
        ;;
esac

# --enable-bootstrap auto-downloads toolchains via `mach bootstrap`. On the
# windows-latest CI runner the MSVC/Win11 SDK is already installed, and the
# bootstrap SDK download hangs on Microsoft's CDN (the "X64 Debuggers And Tools"
# MSI never finishes — the build freezes ~30s in). firefox-11/12 built Windows
# fine without it, using the runner's pre-installed SDK. So enable bootstrap
# only off Windows (Linux/macOS download their toolchains fine).
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT) ;;
    *) ac_add_options --enable-bootstrap ;;
esac

export MOZ_REQUIRE_SIGNING=

mk_add_options MOZ_CRASHREPORTER=0
mk_add_options MOZ_DATA_REPORTING=0
mk_add_options MOZ_SERVICES_HEALTHREPORT=0
mk_add_options MOZ_TELEMETRY_REPORTING=0
mk_add_options MOZ_INSTALLER=0
mk_add_options MOZ_AUTOMATION_INSTALLER=0
