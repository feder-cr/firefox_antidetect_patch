ac_add_options --enable-application=browser

# ============================================================================
# PARITA' COL RETAIL - firefox-21, decisione del proprietario 2026-08-19:
# "dobbiamo essere il piu' simili possibile a retail, quindi usa tutte le cose
# del retail".
#
# ⛔ QUESTO FILE NON E' STATO SCRITTO A INTUITO. E' allineato al mozconfig con
# cui Mozilla costruisce la release win64, che sta nell'albero e si legge:
#     browser/config/mozconfigs/win64/release
#       -> build/mozconfig.win-common          (vuoto)
#       -> browser/config/mozconfigs/win64/common-win64   (target + clang-cl)
#       -> browser/config/mozconfigs/win64/common-opt
#            --enable-update-channel=${MOZ_UPDATE_CHANNEL}
#            --with-google-location-service-api-keyfile=...
#            --with-google-safebrowsing-api-keyfile=...
#            --with-mozilla-api-keyfile=...
#            export MOZILLA_OFFICIAL=1
#            export MOZ_PACKAGE_JSSHELL=1
#       -> --enable-official-branding
#       -> build/mozconfig.common   (AUTOCLOBBER=1, --enable-js-shell)
#
# Il fatto che conta: in quella catena NON C'E' NEMMENO UN `--disable-*`.
# Crashreporter, background task, test e i tre agenti Windows sono tutti ACCESI
# in una release. Ogni `--disable-` che avevamo era una divergenza dal retail.
# ============================================================================

ac_add_options --disable-debug
ac_add_options --enable-release

# ⛔ MOZILLA_OFFICIAL non e' un dettaglio di targa: e' il fatto da cui dipendono
# sei prefs piu' due cancelli di build, e DUE di quelle prefs viaggiano DENTRO
# la richiesta a Google Safe Browsing:
#
#   browser.safebrowsing.id      navclient-auto-ffox  <- ufficiale
#                                Firefox              <- noi, prima di qui
#   urlclassifier.phishTable     goog-phish-proto     <- ufficiale
#                                googpub-phish-proto  <- noi, prima di qui
#
# Il commento upstream accanto e' esplicito: "These names are approved by the
# Google Safe Browsing team". Accendere Safe Browsing SENZA questo flag avrebbe
# mandato a Google due valori che ci dichiarano build non ufficiale: non
# un'assenza, un tell positivo. Per questo il flag viene PRIMA della chiave.
#
# Le altre quattro: browser.dom.window.dump.enabled, devtools.chrome.enabled,
# devtools.debugger.remote-enabled, termsofuse.bypassNotification.
# I due cancelli di build: GetIsOfficialTelemetry (Telemetry.cpp:746-754) e
# MOZ_TELEMETRY_REPORTING, che ha `default=mozilla_official`.
export MOZILLA_OFFICIAL=1

# Il canale compare nella URL di aggiornamento e determina MOZ_APP_REMOTINGNAME
# (toolkit/moz.configure:3336-3350): con "release" vale `firefox`, altrimenti
# `firefox-<canale>`, e il nostro era `firefox-default`.
ac_add_options --enable-update-channel=release

# ⛔ IL MARCHIO. Questa riga fa dichiarare al binario ProductName=Firefox e
# IsPrivateBuild=false, cioe' cio' che `scripts/judge.py` usa per distinguere un
# retail da una build non ufficiale: oggi il NOSTRO binario si dichiara
# "Nightly" e "private". Nessuna PAGINA puo' leggere quei metadati, quindi non
# e' realness verso un sito; e' fedelta' verso chi ispeziona il file.
#
# ⛔ E PORTA UNA QUESTIONE CHE NON E' TECNICA: la politica sui marchi di Mozilla
# non consente di distribuire un Firefox MODIFICATO con il marchio ufficiale.
# Costruire in locale non distribuisce niente; PUBBLICARE un asset costruito
# cosi' e' la decisione, e va presa dal proprietario dell'account - lo stesso
# che e' gia' stato sospeso una volta. Finche' non e' decisa, la riga sta qui
# per la build locale e il gate di pubblicazione deve fermarla.
ac_add_options --enable-official-branding

# ⛔ LE TRE CHIAVI. Mozilla ne passa TRE, non una: Safe Browsing, Google Location
# Service e la chiave Mozilla per la geolocalizzazione. Senza, ognuna ha la sua
# sentinella, e la sentinella e' peggio dell'assenza dove finisce dentro una URL
# (misurato: SendRemoteQueryInternal non controlla la chiave, quindi la
# reputazione dei download manderebbe `key=no-google-safebrowsing-api-key` a
# Google - vedi la nota in invisible_core/prefs.py).
#
# I file NON stanno nell'albero e non devono starci: sono credenziali (regola 2).
# Le righe sono condizionali perche' senza il file `configure` fallisce con
# FatalCheckError, e una build che non parte e' peggio di una senza chiave.
MOZ_SB_KEYFILE="${MOZ_SB_KEYFILE:-/c/tmp/.sbkey}"
MOZ_GLS_KEYFILE="${MOZ_GLS_KEYFILE:-/c/tmp/.glskey}"
MOZ_MOZ_KEYFILE="${MOZ_MOZ_KEYFILE:-/c/tmp/.mozkey}"
if [ -f "$MOZ_SB_KEYFILE" ]; then
    ac_add_options --with-google-safebrowsing-api-keyfile="$MOZ_SB_KEYFILE"
fi
if [ -f "$MOZ_GLS_KEYFILE" ]; then
    ac_add_options --with-google-location-service-api-keyfile="$MOZ_GLS_KEYFILE"
fi
if [ -f "$MOZ_MOZ_KEYFILE" ]; then
    ac_add_options --with-mozilla-api-keyfile="$MOZ_MOZ_KEYFILE"
fi

# ⛔ QUI SOTTO C'ERANO SEI `--disable-`, E OGNUNO ERA UNA DIVERGENZA.
# Tolti tutti, perche' la release di Mozilla non ne ha nessuno:
#
#   --disable-crashreporter        il retail ce l'ha (default=crashreporter_default)
#   --disable-backgroundtasks      il retail ce l'ha
#   --disable-tests                il retail li compila (moz.configure:91, default on)
#   --disable-default-browser-agent \
#   --disable-maintenance-service   > tutti e tre accesi in una release win64
#   --disable-update-agent         /
#
# Gli agenti Windows non modificano la macchina per il solo fatto di essere
# compilati: e' l'INSTALLER a registrare servizi e attivita' pianificate, e noi
# spediamo un archivio. Compilarli allinea l'elenco dei file del pacchetto al
# retail senza installare niente.
#
# `MOZ_REQUIRE_SIGNING` era esportata VUOTA, cioe' spenta. Il default e'
# `require_signing` e sul canale release e' ACCESO (toolkit/moz.configure:2034).
# ⛔ Conseguenza da conoscere: con la firma richiesta, un'estensione non firmata
# non si carica. Juggler e' compilato dentro e non e' un'estensione, quindi il
# percorso del prodotto non cambia; cambia per chi carica estensioni proprie.

# L'updater: il retail lo ha compilato e CONTROLLA all'avvio. Noi controlliamo
# come lui, ma `app.update.auto=false` in invisible_core impedisce download e
# installazione - installare distruggerebbe il binario pinnato dal sigillo.
# (`app.update.enabled` non esiste piu' in 151: era una pref morta.)

ac_add_options --enable-bootstrap

# Bundle the Windows core font set on EVERY desktop OS. bundled_fonts_default in
# toolkit/moz.configure enables MOZ_BUNDLED_FONTS only for Windows + Linux, so
# macOS defaulted OFF: the bundle never loaded and our bundle-only block-at-birth
# hooks (behind #ifdef MOZ_BUNDLED_FONTS) were compiled out, leaking host fonts.
# Enabling it explicitly is a no-op on Win/Linux (already on) and turns the
# self-contained font persona on for macOS. The font files are packaged on cocoa
# already (browser/fonts/moz.build).
#
# ⛔ E' l'UNICA divergenza deliberata rimasta dal mozconfig di release, ed e'
# una funzione di stealth, non una soppressione: aggiunge font, non ne toglie.
ac_add_options --enable-bundled-fonts

# L'installer NSIS resta fuori: e' un ARTEFATTO separato, non una proprieta' del
# browser che gira. Il retail lo spedisce, noi spediamo un archivio, e nessuna
# pagina ne' la rete possono distinguere le due cose. Il js shell (che Mozilla
# impacchetta con MOZ_PACKAGE_JSSHELL) resta fuori per la stessa ragione.
mk_add_options MOZ_INSTALLER=0
mk_add_options MOZ_AUTOMATION_INSTALLER=0

# HTTP/3 verso Google: il proxy non implementa UDP ASSOCIATE, quindi QUIC non
# passa e non passera' finche' si esce da questi proxy.
#
# ⛔ MA NON E' UN DIVARIO NOSTRO, e la riga che stava qui diceva il contrario.
# Era stata scritta confrontando il NOSTRO percorso proxato con un retail
# DIRETTO, che mescola "siamo diversi" con "il proxy e' diverso". Misurato il
# 2026-08-19 con tre bracci sulla stessa uscita pinnata e lo stesso strumento:
# il retail DIRETTO usa h3, il retail DAL PROXY no, noi dal proxy no, e tutti e
# tre ricevono `alt-svc: h3=":443"` da Google. Quindi non ci separa da un retail
# che esce dallo stesso posto, e non c'e' niente da recuperare.
# Il conto per esteso: docs/firefox-stealth-architecture/27-retail-network-parity.md
# sezione 9.
