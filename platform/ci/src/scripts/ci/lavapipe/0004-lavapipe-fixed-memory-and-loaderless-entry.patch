+/* Firefox's bundled lavapipe has no Vulkan loader: Firefox maps this library
+ * under the loader's name (SONAME libvulkan.so.1) and its wgpu asks it for
+ * vkGetInstanceProcAddr directly. No manifest, no layers, no host driver. */
+PUBLIC
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vkGetInstanceProcAddr(
+   VkInstance                                  instance,
