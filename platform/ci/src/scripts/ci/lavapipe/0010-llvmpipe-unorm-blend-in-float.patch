+/**
+ * Unpack a vector of memory pixels (any block width 8..64) of an all-UNORM
+ * format to float SoA rgba, exactly (N / (2^bits - 1)). Channels the format
+ * does not have read as 0, and alpha as 1.
+ */
+static void
+unorm_to_float_soa(struct gallivm_state *gallivm,
+                   const struct util_format_description *fmt,
+                   struct lp_type dst_type,
+                   LLVMValueRef packed,
+                   LLVMValueRef out[4])
+{
+   LLVMBuilderRef builder = gallivm->builder;
+   struct lp_build_context bld;
+   LLVMTypeRef ivec = lp_build_int_vec_type(gallivm, dst_type);
+   const unsigned w = LLVMGetIntTypeWidth(LLVMGetElementType(LLVMTypeOf(packed)));
+   struct lp_type wtype = lp_int_type(dst_type);
+   LLVMValueRef chan[4] = { NULL, NULL, NULL, NULL };
+
+   lp_build_context_init(&bld, gallivm, dst_type);
+   wtype.width = w;
+   wtype.sign = false;
+
+   for (unsigned c = 0; c < fmt->nr_channels; c++) {
+      const struct util_format_channel_description *d = &fmt->channel[c];
+      if (d->type == UTIL_FORMAT_TYPE_VOID)
+         continue;
+
+      LLVMValueRef v = packed;
+      if (d->shift) {
+         v = LLVMBuildLShr(builder, v,
+                           lp_build_const_int_vec(gallivm, wtype, d->shift), "");
+      }
+      v = LLVMBuildAnd(builder, v,
+                       lp_build_const_int_vec(gallivm, wtype,
+                                              (1ULL << d->size) - 1), "");
+      if (w > 32)
+         v = LLVMBuildTrunc(builder, v, ivec, "");
+      else if (w < 32)
+         v = LLVMBuildZExt(builder, v, ivec, "");
+      chan[c] = lp_build_unsigned_norm_to_float(gallivm, d->size, dst_type, v);
+   }
+
+   for (unsigned i = 0; i < 4; i++) {
+      const unsigned sw = fmt->swizzle[i];
+      if (sw <= PIPE_SWIZZLE_W && chan[sw])
+         out[i] = chan[sw];
+      else
+         out[i] = (sw == PIPE_SWIZZLE_1) ? bld.one : bld.zero;
+   }
+}
