+/**
+ * Convert float SoA rgba values to the packed unorm pixel of dst_fmt (any
+ * block width 8..64; the result has 32-bit lanes, or 64-bit for 64-bit
+ * blocks, and the caller narrows it).
+ *
+ * Each channel is clamped to [0,1] and converted with one round-to-nearest
+ * (that is the only rounding a blended value gets, as on D3D11).
+ */
+static LLVMValueRef
+float_to_unorm_packed(struct gallivm_state *gallivm,
+                      const struct util_format_description *dst_fmt,
+                      struct lp_type src_type,
+                      LLVMValueRef *src)
+{
+   LLVMBuilderRef builder = gallivm->builder;
+   struct lp_build_context f32_bld;
+   struct lp_type wtype = lp_int_type(src_type);
+   wtype.width = dst_fmt->block.bits > 32 ? 64 : 32;
+   wtype.sign = false;
+   LLVMTypeRef wvec = lp_build_vec_type(gallivm, wtype);
+   LLVMValueRef dst = lp_build_zero(gallivm, wtype);
+
+   lp_build_context_init(&f32_bld, gallivm, src_type);
+
+   for (unsigned c = 0; c < dst_fmt->nr_channels; c++) {
+      const struct util_format_channel_description *d = &dst_fmt->channel[c];
+      if (d->type == UTIL_FORMAT_TYPE_VOID)
+         continue;
+
+      /* the rgba component that feeds memory channel c */
+      unsigned i;
+      for (i = 0; i < 4; i++) {
+         if (dst_fmt->swizzle[i] == c)
+            break;
+      }
+      if (i == 4)
+         continue;
+
+      LLVMValueRef v = lp_build_clamp_zero_one_nanzero(&f32_bld, src[i]);
+      v = lp_build_clamped_float_to_unsigned_norm(gallivm, src_type, d->size, v);
+      if (wtype.width == 64)
+         v = LLVMBuildZExt(builder, v, wvec, "");
+      if (d->shift) {
+         v = LLVMBuildShl(builder, v,
+                          lp_build_const_int_vec(gallivm, wtype, d->shift), "");
+      }
+      dst = LLVMBuildOr(builder, dst, v, "");
+   }
+   return dst;
+}
