+/**
+ * Is this a UNORM colour buffer that must be blended in float?
+ *
+ * Matches D3D11: the blend is computed from the unquantized shader output and
+ * the exact destination value, in float, and the result is rounded to the
+ * buffer's unorm grid once, when it is stored. The AoS blend below works on
+ * the render target format instead: the shader output is first quantized to
+ * the buffer's bits and the blend then runs as fixed point arithmetic (t/max
+ * approximations), so the source is rounded twice and the result can be 1 LSB
+ * off what real GPUs produce. So for plain UNORM formats (R8, RG8, RGBA8,
+ * RGBX8, BGRA/BGRX, RGB565, RGBA4, RGB5_A1, RGB10_A2, R16, RG16, RGBA16 ...)
+ * treat the buffer like the sRGB ones: unpack the destination to float, blend
+ * in float, and convert with a single round-to-nearest on the way back.
+ */
+static inline bool
+blend_unorm_in_float(const struct util_format_description *format_desc,
+                     const struct pipe_blend_state *blend,
+                     unsigned rt)
+{
+   if (!blend->rt[rt].blend_enable || blend->logicop_enable)
+      return false;
+   if (format_expands_to_float_soa(format_desc))
+      return false;
+   if (format_desc->layout != UTIL_FORMAT_LAYOUT_PLAIN ||
+       format_desc->colorspace != UTIL_FORMAT_COLORSPACE_RGB ||
+       format_desc->block.width != 1 || format_desc->block.height != 1)
+      return false;
+   if (format_desc->block.bits != 8 && format_desc->block.bits != 16 &&
+       format_desc->block.bits != 32 && format_desc->block.bits != 64)
+      return false;
+   if (util_format_is_alpha(format_desc->format) ||
+       util_format_is_luminance(format_desc->format) ||
+       util_format_is_luminance_alpha(format_desc->format) ||
+       util_format_is_intensity(format_desc->format))
+      return false;
+   unsigned nr_used = 0;
+   for (unsigned i = 0; i < format_desc->nr_channels; i++) {
+      const struct util_format_channel_description *c = &format_desc->channel[i];
+      if (c->type == UTIL_FORMAT_TYPE_VOID)
+         continue;
+      if (c->type != UTIL_FORMAT_TYPE_UNSIGNED || !c->normalized ||
+          c->pure_integer || c->size > 16)
+         return false;
+      nr_used++;
+   }
+   return nr_used > 0;
+}
